{
  "name": "lexical-ugly-footnotes",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.server.js",
  "types": "./dist/index.server.d.ts",
  "typesVersions": {
    "*": {
      "server": ["./dist/index.server.d.ts"],
      "client": ["./dist/index.client.d.ts"],
      "*": ["./dist/index.server.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.server.d.ts",
      "react-server": "./dist/index.server.js",
      "browser": "./dist/index.client.js",
      "default": "./dist/index.server.js"
    },
    "./server": {
      "types": "./dist/index.server.d.ts",
      "default": "./dist/index.server.js"
    },
    "./client": {
      "types": "./dist/index.client.d.ts",
      "default": "./dist/index.client.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "turbo run build:styles build:components",
    "build:components": "tsc",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "dev:components": "tsc --watch",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev": "turbo run dev:styles dev:components",
    "circular:npx": "npx madge --circular --extensions ts,tsx --ts-config ./tsconfig.json ./src",
    "pack:test": "rm -f ./*.tgz && pnpm pack --silent && tar -xzf ./*.tgz -O package/package.json"
  },
  "peerDependencies": {
    "@lexical/react": "catalog:",
    "@lexical/utils": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/history": "catalog:",
    "@lexical/plain-text": "catalog:",
    "@lexical/selection": "catalog:",
    "@lexical/html": "catalog:",
    "lexical": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "@repo/tailwind-config": "workspace:*",
    "tailwindcss": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "catalog:"
  },
  "dependencies": {
    "uuid": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
